# Copy to .env.local for local dev. On Vercel, set these in
# Project > Settings > Environment Variables.
#
# Keep this file as placeholders only - .env.local is the one with real
# credentials and is gitignored. Never commit a real service-role key.

# From Supabase: Project Settings > API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
